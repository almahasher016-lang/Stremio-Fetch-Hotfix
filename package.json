{
  "name": "m7md-arabic-stremio-subtitles",
  "version": "3.5.1",
  "type": "module",
  "private": true,
  "description": "Private direct Stremio Arabic subtitles add-on with edition-aware deterministic ranking, styled ASS/SSA delivery, resilient providers, media fingerprinting, Personal Vault backups, smart cache, and reference synchronization without AI.",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "companion:scan": "node src/companion/mediaCompanion.js scan",
    "test": "node --import ./src/tests/setup.js --test src/tests/*.test.js",
    "test:coverage": "node --import ./src/tests/setup.js --experimental-test-coverage --test-coverage-lines=75 --test-coverage-branches=65 --test-coverage-functions=75 --test src/tests/*.test.js",
    "test:contracts": "node --import ./src/tests/setup.js --test src/tests/liveProviders.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:coverage"
  },
  "dependencies": {
    "@napi-rs/lzma": "1.5.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "fflate": "0.8.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "undici": "^8.9.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "eslint": "10.7.0",
    "typescript": "7.0.2"
  }
}
