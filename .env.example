NODE_ENV=production
PUBLIC_BASE_URL=

# Required production secrets; use distinct random values of at least 32 bytes.
ENCODING_PROXY_SECRET=
ADMIN_TOKEN=

# Enable only the providers you configure.
SUBTITLE_PROVIDERS=opensubtitles,subdl,yify
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_TOKEN=
SUBDL_API_KEY=
SUBSOURCE_API_KEY=

PROVIDER_EXCLUDE_MACHINE_TRANSLATED=true
PROVIDER_EXCLUDE_HEARING_IMPAIRED=true
PROVIDER_STRICT_QUALITY_FILTERS=true
PROVIDER_MAX_CONCURRENT=2
PROVIDER_MIN_INTERVAL_MS=100
CIRCUIT_BREAKER_LIMIT=4
CIRCUIT_BREAKER_RESET_MS=30000
CIRCUIT_BREAKER_MAX_RESET_MS=240000
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=60
ADMIN_AUTH_RATE_LIMIT_WINDOW_MS=60000
ADMIN_AUTH_RATE_LIMIT_MAX=30
RATE_LIMIT_PASS_ON_STORE_ERROR=true
CACHE_SINGLEFLIGHT_WAIT_MS=5000
CACHE_SINGLEFLIGHT_POLL_MS=100

# Stale provider links are unsafe until the two-layer SWR cache is implemented.
CACHE_STALE_WHILE_REVALIDATE=false
ENABLE_TEST_UI=false

# Mount a Railway Volume at /app/data for durable Vault/registry storage.
PERSONAL_VAULT_PATH=/app/data/personal-vault.json
VERSION_REGISTRY_PATH=/app/data/version-registry.json

# Shared Redis enables distributed cache, rate limits, and cold-cache request coalescing.
REDIS_URL=

# Optional OpenTelemetry OTLP/HTTP tracing. The endpoint must include /v1/traces.
ENABLE_TRACING=false
OTEL_SERVICE_NAME=m7md-arabic-stremio-subtitles
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
