NODE_ENV=production
PUBLIC_BASE_URL=

# Required production secrets; use distinct random values of at least 32 bytes.
ENCODING_PROXY_SECRET=
ADMIN_TOKEN=

# Enable only the providers you configure.
SUBTITLE_PROVIDERS=opensubtitles,subdl,yify
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_TOKEN=
SUBDL_API_KEY=
SUBSOURCE_API_KEY=

PROVIDER_EXCLUDE_MACHINE_TRANSLATED=true
PROVIDER_EXCLUDE_HEARING_IMPAIRED=true
PROVIDER_STRICT_QUALITY_FILTERS=true
PROVIDER_MAX_CONCURRENT=2
PROVIDER_MIN_INTERVAL_MS=100
CIRCUIT_BREAKER_LIMIT=4
CIRCUIT_BREAKER_RESET_MS=30000
CIRCUIT_BREAKER_MAX_RESET_MS=240000
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=60
ADMIN_AUTH_RATE_LIMIT_WINDOW_MS=60000
ADMIN_AUTH_RATE_LIMIT_MAX=30
RATE_LIMIT_PASS_ON_STORE_ERROR=true
CACHE_SINGLEFLIGHT_WAIT_MS=5000
CACHE_SINGLEFLIGHT_POLL_MS=100

# Stale provider links are unsafe until the two-layer SWR cache is implemented.
CACHE_STALE_WHILE_REVALIDATE=false
ENABLE_TEST_UI=false

# Mount a Railway Volume at /app/data for durable Vault/registry storage.
PERSONAL_VAULT_PATH=/app/data/personal-vault.json
VERSION_REGISTRY_PATH=/app/data/version-registry.json

# Shared Redis enables distributed cache, rate limits, and cold-cache request coalescing.
REDIS_URL=

# Optional OpenTelemetry OTLP/HTTP tracing. The endpoint must include /v1/traces.
ENABLE_TRACING=false
OTEL_SERVICE_NAME=m7md-arabic-stremio-subtitles
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Synchronization derived only from timing structure is experimental and disabled by default.
ALLOW_EXPERIMENTAL_SYNC=false
ENABLE_AUTO_SYNC_OPTION=false
ENABLE_REFERENCE_AUTO_SYNC=false
TOP_N=10
STREMIO_MAX_SUBTITLES=12
STREMIO_ORIGINAL_TOP=10
RESOLVER_MAX_PROVIDERS_PER_STAGE=4
RESOLVER_RECOVERY_ENABLED=true
RESOLVER_RECOVERY_MIN_RANK_SCORE=-250
RESOLVER_RECOVERY_MAX_ALIASES=2
ENCODING_PROXY_MAX_FALLBACKS=4

# Resolver V5 Proof-First rollout. Shadow observes without changing output.
# Leave RESOLVER_V5_MODE empty until audited precision clears the V5 statistical gate.
RESOLVER_V5_SHADOW=false
RESOLVER_V5_MODE=

# Shared durable state (production / HA)
DATABASE_URL=
POSTGRES_POOL_MAX=6

# Enterprise accuracy preflight (shared Redis cache across replicas)
ACCURACY_PREFLIGHT_ENABLED=true
ACCURACY_PREFLIGHT_TOP_N=10
ACCURACY_PREFLIGHT_TIMEOUT_MS=1800
ACCURACY_PREFLIGHT_CACHE_TTL=21600
ACCURACY_PREFLIGHT_REJECT_CACHE_TTL=180
ARABIC_LKG_TTL=900
ARABIC_LKG_STALE_SECONDS=604800

# Runtime SLO thresholds used by authenticated /api/admin/slo
SLO_MIN_HTTP_SAMPLES=20
SLO_MIN_PROVIDER_SAMPLES=5
SLO_MIN_PREFLIGHT_SAMPLES=5
SLO_HTTP_P95_MS=5000
SLO_HTTP_P99_MS=8000
SLO_HTTP_5XX_RATE=0.02
SLO_EVENT_LOOP_P99_MS=150
SLO_PROVIDER_P95_MS=10000
SLO_PROVIDER_SUCCESS_RATE=0.70
SLO_PREFLIGHT_UNAVAILABLE_RATE=0.50
ACCURACY_PREFLIGHT_REMOTE_FRESH_MS=120000
